# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Input data: the PDFs are not in git (a GitHub release holds them, and
# data/pdfs.csv lists them with their size and hash); the household
# code usage table is, so the raw-data checks run in CI
/data/*
!/data/code_usage.csv
!/data/pdfs.csv

# review aids written by the build (label check, code reuse, relation evidence)
/reports/
/site/

# local Claude Code preview config
/.claude/

# Drafts
*_draft.py
